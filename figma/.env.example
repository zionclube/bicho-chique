# Copie para .env e preencha na máquina. Não commite o .env.
# Nenhum destes nomes usa o prefixo NEXT_PUBLIC_.
#
# SESSION_SECRET: pelo menos 32 caracteres.
# CPF_ENCRYPTION_KEY e CPF_HMAC_KEY: 32 bytes em base64.
# Gere cada um com: openssl rand -base64 32

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/bicho_chique
SESSION_SECRET=
CPF_ENCRYPTION_KEY=
CPF_HMAC_KEY=
